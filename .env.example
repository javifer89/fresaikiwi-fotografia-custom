# Copy to .env.local and fill in the real values.
# Never commit .env or .env.local - they are gitignored.

# Public site URL used by metadata, sitemap.xml and robots.txt.
# Falls back to https://fresaikiwifotografia.com when unset.
NEXT_PUBLIC_URL=https://fresaikiwifotografia.com

# Formspree form endpoint that receives contact form submissions.
# Required: the /api/contact route returns 500 when it is missing.
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
