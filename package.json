{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fast": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "build:fast": "cross-env NEXT_TELEMETRY_DISABLED=1 NEXT_SKIP_TYPE_CHECK=1 NEXT_SKIP_LINTING=1 next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "ci": "npm run type-check && npm run lint",
    "clean": "rimraf .next node_modules/.cache"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/node": "^24",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "2.1.4",
    "@tailwindcss/postcss": "4.3.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "rimraf": "^5.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "vercel": "^50.0.0"
  },
  "overrides": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.4"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "16.1.6",
    "@next/swc-linux-x64-gnu": "16.1.6",
    "@next/swc-linux-x64-musl": "16.1.6"
  }
}
